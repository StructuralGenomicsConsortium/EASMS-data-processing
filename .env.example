
PROJECT_ID=my-gcp-project

# --- GCP placement ---
REGION=us-central1
AR_REPO=easms
JOB_NAME=easms-curation
RUNTIME_SA_NAME=easms-curation-job

# --- Buckets (config + raw data live in INPUT_BUCKET; outputs in OUTPUT_BUCKET) ---
INPUT_BUCKET=asms_sgc-toronto
OUTPUT_BUCKET=test-aircheck

# --- Cloud Run Job sizing ---
CPU=8
MEMORY=16Gi
TASK_TIMEOUT=3600
MAX_RETRIES=1

# --- Local run (pull/run-local): AR images are amd64; keep this on Apple Silicon ---
PLATFORM=linux/amd64

# --- Per-run inputs (optional; default to paths derived from the buckets above) ---
# INPUT_FILE=gs://asms_sgc-toronto/data/asms_sgcto_1_DEMOLIB_20260101.csv
# OUTPUT_DIR=gs://test-aircheck/asms-out
# MASTERLISTS=gs://asms_sgc-toronto/library/EASMS12kV1_lib.csv
# PROVIDERS=gs://asms_sgc-toronto/config/Providers.csv


